# Test-mode only. Supply through secure environment configuration; never commit values.
APP_ORIGIN=http://127.0.0.1:3003
PORT=3003
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Local integration testing only. Disabled by default.
# ENABLE_DEV_LOGIN=1

# Local customer account preview. Real email delivery is not configured.
# ENABLE_CUSTOMER_ACCOUNTS=1

# Local-only volatile test inbox. Never enable in public hosting.
# ENABLE_DEV_INBOX=1

# Opt-in test accounting for direct 3MF downloads, NOT live payment enforcement.
# ENABLE_EXPORT_CREDIT_TRIAL=1

# Hosted account email: uses the server's existing local mail service.
# Keep disabled until the program/sender are verified. No SMTP password required.
# EMAIL_TRANSPORT=sendmail
# EMAIL_FROM=noreply@coasterprint.com
# SENDMAIL_PATH=/usr/sbin/sendmail

# After public domain routing and HTTPS are configured:
# APP_ORIGIN=https://coasterprint.com
